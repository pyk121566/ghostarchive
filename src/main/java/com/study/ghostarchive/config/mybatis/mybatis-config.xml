<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration
  PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-config.dtd">
  
  <configuration>
  	
  	<!-- 이 설정으로 Mybatis가 oracle의 언더스코어 컬럼이름을 java의 카멜케이스 필드와 자동으로 연결해줌 -->
  	<settings>
  		<setting name="mapUnderscoreToCamelCase" value="true"/>	
  	</settings>
  	
  	<typeAliases>
  		<typeAlias type="com.study.ghostarchive.dto.GhostDTO"		alias="GhostDTO"/>
  		<typeAlias type="com.study.ghostarchive.dto.GhostCommentDTO"		alias="GhostCommentDTO"/>
  		<typeAlias type="com.study.ghostarchive.common.web.Pager"		alias="Pager"/>
  	</typeAliases>
  	
  </configuration>